pub struct HttpRequest<'a> {
    pub hostname: &'a [u16],
    pub path: &'a [u16],
    pub method: &'a [u16],
    pub headers: &'a [&'a [u16]],
    pub body: Option<&'a [u8]>,
    pub accept: &'a [u16],
}

impl<'a> HttpRequest<'a> {}

fn utf8_to_utf16(s: &str, buf: &mut [u16]) -> usize {
    let mut i = 0;
    for c in s.encode_utf16() {
        if i == buf.len() {
            break;
        }
        buf[i] = c;
        i += 1;
    }
    i
}

pub fn to_utf16(
    hostname: &'a str,
    path: &'a str,
    method: &'a str,
    headers: &'a [&'a str],
    body: Option<&'a str>,
    accept: &'a str,
) -> [[u16]] {
    let ret = [0u16; 24]
    let mut hostname_utf16 = [0u16; 256];
    utf8_to_utf16(hostname, &hostname_utf16);

    let mut path_utf16 = [0u16; 256];
    utf8_to_utf16(path, &path_utf16);

    let mut method_utf16 = [0u16; 256];
    utf8_to_utf16(method, &method_utf16);

    if let Some(body) = body {
        let mut body_utf16 = [0u16; 256];
        utf8_to_utf16(body, &body_utf16);
    }

    let mut accept_utf16 = [0u16; 256];
    utf8_to_utf16(accept, &accept_utf16);
}
